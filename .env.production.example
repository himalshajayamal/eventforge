# EventForge v0.9 production environment template.
# Prefer generating .env.production with:
#   python tools/generate_production_env.py --host eventforge.example.com
#
# Empty required secrets intentionally make Compose fail fast.

POSTGRES_DB=eventforge
POSTGRES_USER=eventforge
POSTGRES_PASSWORD=
DATABASE_URL=

# Public Caddy site address:
#   public: eventforge.example.com
#   local production-mode test: http://localhost
EVENTFORGE_PUBLIC_HOST=
EVENTFORGE_HTTP_BIND=80
EVENTFORGE_HTTPS_BIND=443

EVENTFORGE_ENV=production
EVENTFORGE_ADMIN_USER=eventforge
EVENTFORGE_ADMIN_PASSWORD=
EVENTFORGE_WEBHOOK_MASTER_SECRET=
EVENTFORGE_REQUIRE_SIGNED_WEBHOOKS=1
EVENTFORGE_MAX_INGEST_BYTES=1048576

EVENTFORGE_WORKER_POLL_SECONDS=0.5
EVENTFORGE_JOB_LEASE_SECONDS=30
EVENTFORGE_JOB_HEARTBEAT_SECONDS=10
EVENTFORGE_RETRY_BASE_SECONDS=2
EVENTFORGE_RETRY_MAX_SECONDS=600

EVENTFORGE_HTTP_ACTION_MAX_RESPONSE_BYTES=1048576
EVENTFORGE_ALLOW_PRIVATE_HTTP_ACTIONS=0
EVENTFORGE_ALLOW_INSECURE_HTTP_ACTIONS=0
EVENTFORGE_HTTP_ACTION_ALLOWED_PORTS=443

EVENTFORGE_BACKUP_DIR=./backups
